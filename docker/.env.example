# 复制为 .env 后填写。以下值只在本机使用，不要外传、不要提交 git。

# ---- 必填 ----
# 客户端访问代理用的 Bearer 密钥
TA_API_KEY=change-me-to-a-long-random-string
# 管理台令牌（局域网访问管理台必须携带）
TA_ADMIN_TOKEN=change-me-to-another-long-random-string

# ---- 端口暴露方式（决定管理台怎么进）----
# PC 本机自用：127.0.0.1（只绑宿主回环，局域网连不上，管理台免令牌，最省心）
# NAS 给局域网用：0.0.0.0（默认；管理台需令牌，见下方 TA_ADMIN_ALLOW_REMOTE）
TA_BIND_ADDR=127.0.0.1
# 仅当 TA_BIND_ADDR=127.0.0.1 时才能设 1。
# 原因：容器里「宿主的 127.0.0.1」和「局域网另一台机器」在 socket 层不可区分
# （都表现为网桥网关地址），只能靠「端口没暴露到局域网」这个前提来判定本机。
# 绑定 0.0.0.0 时务必设为 0，否则局域网任何人都能无令牌打开管理台。
TA_ADMIN_LOCAL_ONLY=1

# 局域网打开管理台（远程访问强制带令牌；未带令牌时返回令牌输入页）
TA_ADMIN_ALLOW_REMOTE=1

# ---- 登录入口（仅用于「打开官方登录页」按钮）----
# 已内置官方网页版登录页，**平时不用填**。仅当官方改域名时覆盖。
# 现在的主登录通道是「用 Cookie 登录」：网页版登录后从 F12 复制
# operationToken / 完整 Cookie 头，粘进管理台即可（同时完成登录与续期凭据导入）。
# 不要指望从回执页复制 token —— 那条链会唤起客户端且 code 一加载即失效，见 DEPLOY-GUIDE 2.2。
# TA_LOGIN_PAGE_URL=

# ---- 可选调优（默认值已按 7×24 场景设好）----
# 看门狗间隔（内核进程死后自动复活）
TA_WATCHDOG_MS=15000
# 自动续期间隔（毫秒）。官方客户端节奏 = 启动补偿 + 每 6h，同一自然日只尝试一次。
# 设为 0 关闭自动续期（不推荐：token 7 天过期后需重新登录）
TA_RENEW_INTERVAL_MS=21600000
# 部署模式：默认 auto —— NAS/容器（无桌面版）自动判 nas（换发闭环全功能）；
# PC 上检测到桌面版数据目录自动判 gui-companion（换发由桌面版独占，反代跟随）。
# NAS 容器里固定 nas 即可，无需改动；仅 PC 上想让反代独占换发时设 nas（自担双客户端竞争风险）。
# TA_RENEW_MODE=nas
# gui-companion 跟随桌面版 token.json 的检测间隔（毫秒，仅 gui-companion 模式生效）
# TA_FOLLOW_INTERVAL_MS=60000
# ARM64 NAS 且构建机无法自动识别架构时手动指定：amd64 / arm64
# TA_ARCH=arm64
